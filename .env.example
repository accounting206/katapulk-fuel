# Copia este archivo como .env y completa. NUNCA subas .env a git ni lo compartas.
KF_GMAIL_USER=tu_correo@gmail.com
# Contraseña de aplicación: Google Account > Security > 2-Step Verification > App passwords
KF_GMAIL_APP_PASSWORD=
KF_GMAIL_FOLDER=INBOX
KF_GMAIL_QUERY=newer_than:3d (crowley OR seaboard OR triton OR midtex OR nuefuel OR "port consolidated" OR "iso tank" OR ibc OR invoice OR booking OR "arrival notice")
